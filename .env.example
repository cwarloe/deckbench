# Copy to .env for local overrides. Do not put real secrets in this file.
# .gitignore already ignores .env / .env.* (except this example).

# Optional Postgres URL for auth migrations / better-auth.
# Leave unset to use the embedded PGLite path in local/preview builds.
# DATABASE_URL=postgres://user:password@localhost:5432/deckbench

# Auth is on unless explicitly set to "false" (local no-auth testing only).
# VITE_AUTH_ENABLED=true

# Optional comma-separated STUN URLs for WebRTC multiplayer helpers.
# VITE_STUN_URLS=stun:stun.l.google.com:19302

# Optional public hostname used when baking OG / share URLs.
# VITE_PUBLIC_HOSTNAME=example.com
